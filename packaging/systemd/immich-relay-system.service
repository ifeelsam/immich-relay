[Unit]
Description=Immich Relay Android sync daemon (dedicated account)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=immich-relay
Group=immich-relay
ExecStart=/usr/bin/immich-relay run --config /etc/immich-relay/config.yaml --db /var/lib/immich-relay/relay.db
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/immich-relay

[Install]
WantedBy=multi-user.target
